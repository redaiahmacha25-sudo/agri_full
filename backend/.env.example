# AgriConnect Backend Environment Configuration (PostgreSQL)

PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Either provide DATABASE_URL or individual parameters:
# DATABASE_URL=postgres://agriconnect_user:agriconnect_pass@localhost:5432/agriconnect
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agriconnect
DB_SSL=false

# JWT
JWT_SECRET=agriconnect_super_secret_jwt_key_2024_govt_platform
JWT_EXPIRES_IN=24h

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Frontend URL (for CORS)
CORS_ORIGIN=http://localhost:5500
